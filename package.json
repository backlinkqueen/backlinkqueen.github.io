{
  "name": "firebase-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting",
    "deploy:cf": "vite build && wrangler pages deploy --branch main",
    "deploy:netlify": "vite build && netlify deploy --prod --no-build --dir dist",
    "deploy:vercel": "vercel deploy --prod --yes",
    "deploy:r2": "vite build && node scripts/r2.mjs",
    "deploy:neocities": "vite build && node --env-file=.env.deploy scripts/neocities.mjs",
    "deploy:telegraph": "node --env-file=.env.deploy scripts/telegraph.mjs",
    "deploy:surge": "vite build && node --env-file=.env.deploy node_modules/surge/bin/surge ./dist backlinkqueen.surge.sh",
    "deploy:all": "vite build && firebase deploy --only hosting && wrangler pages deploy --branch main && netlify deploy --prod --no-build --dir dist"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0",
    "netlify-cli": "^27.14.2",
    "surge": "^0.51.0",
    "vercel": "^65.2.0",
    "vite": "^7.1.0",
    "wrangler": "^4.152.0"
  }
}
